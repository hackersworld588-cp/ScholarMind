# ScholarMind AI — Environment Configuration

# Server Ports
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=3000

# LLM Providers Configuration
# Supported providers: "gemini", "openai", "anthropic", "local_deterministic"
LLM_PROVIDER=gemini

# Google Gemini API
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
DEFAULT_MODEL=gemini-2.5-flash

# OpenAI API (Optional)
# OPENAI_API_KEY=sk-...

# Anthropic Claude API (Optional)
# ANTHROPIC_API_KEY=sk-ant-...

# Academic & Publication Defaults
DEFAULT_CITATION_STYLE=vancouver
DEFAULT_LANGUAGE="English (US Academic)"
DEFAULT_PAGE_SIZE=A4
DEFAULT_TARGET_WORD_COUNT=5000
